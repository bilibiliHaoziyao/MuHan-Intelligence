{
  "name": "muhan-api",
  "private": true,
  "version": "1.0.0",
  "description": "MuHan Intelligence 账号与同步后端（Cloudflare Workers + D1）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create muhan-db",
    "db:init": "wrangler d1 execute muhan-db --file=./schema.sql --remote",
    "db:local": "wrangler d1 execute muhan-db --file=./schema.sql --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.80.0"
  }
}
